###
# Get Branch list
GET http://localhost:8080/api/branches

###
# Get Branch by id
GET http://localhost:8080/api/branches/1

###
# Create a new Branch
POST http://localhost:8080/api/branches
Content-Type: application/json

{
  "label": "Denain"
}

###
# Update branch with id
PATCH http://localhost:8080/api/branches/3
Content-Type: application/json

{
  "label": "Cauchy-à-la-Tour"
}

###
# Soft Delete user with id
DELETE http://localhost:8080/api/branches/3